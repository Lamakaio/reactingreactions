      "when": {
        "coil_south": "true"
      }
    },
    {
      "apply": {
        "model": "reactingreactions:block/induction_heater_plate_coil",
        "y": 270
      },
      "when": {
        "coil_west": "true"
      }
    },
    {
      "apply": {
        "model": "reactingreactions:block/induction_heater_plate_circle"
      },
      "when": {
